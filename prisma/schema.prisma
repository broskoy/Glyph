generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artwork {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String
  height    Int
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}
